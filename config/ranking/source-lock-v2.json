  "transforms": {
    "broadband": {
      "county_filter": "area_data_type equals Total, geography_type equals County, and geography_id is a current five-digit in-scope county FIPS",
      "technology_filter": "technology equals Any Terrestrial and biz_res equals R with exactly one row per county; reject missing or duplicate R rows and do not average the alternative B view",
      "utility": "u_broadband equals the selected residential-view speed_100_20 share directly; result must be finite in 0-1 and is used without ECDF"
    },
    "calibration": {
      "audit_fields": ["valid_count", "sorted_fips_sha256", "canonical_raw_values_sha256", "direction", "tie_policy", "utilities_sha256"],
      "tie_policy": "average rank mapped to (rank - 1) / (n - 1)",
      "universe": "all source-valid counties in the locked 50-state/DC county universe before every user gate"
    },
    "climate": {
      "aggregation": "equal arithmetic mean across qualifying stations",
      "county_predicate": "station point strictly within one current TIGER 2025 county; boundary points are unassigned",
      "elements": {"extreme_cold_days": "ANN-TMIN-AVGNDS-LSTH032", "extreme_heat_days": "ANN-TMAX-AVGNDS-GRTH090", "jan_avg_temp_f": "MLY-TAVG-NORMAL month 01", "jul_avg_temp_f": "MLY-TAVG-NORMAL month 07"},
      "missing": "all four county values null unless at least one station has all four finite values",
      "nearest_station_fallback": false
    },
    "community_context": {"formula": "(10 - published_group) / 9", "valid_groups": "integers 1 through 10; null remains null"},
    "crime": {
      "agency_types_included": ["Borough", "City", "County", "Metropolitan", "Parish", "Township", "Village"],
      "agency_types_excluded": ["Federal", "Special", "State Police", "Tribal", "University or College"],
      "attribution": "FBI catalog counties field and its containing county group must agree; normalize the single published county label only for punctuation, spacing, diacritics, and legal suffixes, then require an unambiguous 1:1 match to the exact locked Census PEP 2025 current-county universe. Store current county_fips in every included agency row. Exclude and explicitly manifest absent, multiple, or unassignable legacy/split county attribution; conflicting attribution fails qualification. The reviewed manifest records 653 multiple-county, three NOT SPECIFIED, and three retired VALDEZ-CORDOVA exclusions",
      "coverage": "for each county, calendar year, and offense family: sum unique ORI-month participated_population / sum unique ORI-month population",
      "coverage_floor": 0.9,
      "coverage_gate": "violent and property coverage must each be >= 0.90 in 2023, 2024, and 2025",
      "deduplication": "one row per ORI, month, and offense family; duplicate rows fail",
      "limitation": "agency service populations are a reporting-coverage proxy and may overlap; coverage is not a distinct-resident census",
      "rate": "sum offenses across 2023-2025 / (sum participated_population across included ORI-months / 12) * 100000",
      "reported_zero": "zero offenses with positive participated_population is valid; null participation or offense is missing",
      "utility": "0.60 * inverse average-tie ECDF violent rate + 0.40 * inverse average-tie ECDF property rate"
    },
    "employment": {
      "acs_commute": "sum B08303_E002 through B08303_E007 / B08303_E001 when denominator > 0",
      "formula": "0.50 * u_growth + 0.25 * u_weekly_wage + 0.25 * u_commute_under_30",
      "qcew_filter": "county Area Type, Own 0 Total Covered, NAICS 10 Total all industries, Qtr A",
      "qcew_growth": "(2025 annual average employment - 2024 annual average employment) / 2024 annual average employment when 2024 > 0",
      "qcew_wage": "2025 annual average weekly wage",
      "utility": "higher-is-better average-tie ECDF for each component"
    },
    "healthcare": {
      "components": {"dental": "AHRF dent_nf_fed_proflly_activ_23 / PEP 2025 population * 100000", "mental_health": "CHR&R v062_numerator / PEP 2025 population * 100000", "primary_care": "AHRF phys_nf_prim_care_pc_exc_rsdt_23 / PEP 2025 population * 100000"},
      "formula": "equal arithmetic mean of the three higher-is-better national average-tie ECDF utilities",
      "limitation": "provider counts measure availability, not access, quality, or utilization"
    },
    "homeschool": {
      "approximate": true,
      "formula": "use the project-authored state utility directly",
      "notice": "Approximate, project-authored policy preference rubric. It is not legal advice, a legal-compliance determination, school-quality evidence, or a recommendation. Laws and interpretations may change; verify current requirements with official state sources or qualified counsel."
    },
    "housing": {
      "calibration": "piecewise-linear interpolation, clamped outside the policy-authored knots; private rows never define published calibration",
      "knots": [{"cdf": 0.0, "value": 500.0}, {"cdf": 0.4, "value": 1000.0}, {"cdf": 0.9, "value": 2000.0}, {"cdf": 1.0, "value": 2500.0}],
      "readiness": "at least 9 distinct valid months and trailing-12-month median active listings >= 100"
    },
    "mountain": {"formula": "higher-is-better national average-tie ECDF of Mountain Magnitude"},
    "nulls": {
      "connecticut": "retain all nine current planning regions; any legacy-county-only input is null with source-specific status; never allocate legacy values",
      "invalid_denominator": "null",
      "suppressed": "null",
      "territories": "excluded before every join and calibration",
      "unknown_code": "publication failure"
    },
    "population": {"formula": "PEP 2025 estimate used for eligibility and provider denominators only; never a utility"},
    "property_tax": {"formula": "ACS B25103_E001 / B25077_E001 only when both estimates are finite and positive", "label": "median property-tax-to-value proxy", "utility": "inverse national average-tie ECDF"},
    "rpp": {"assignment": "MARPP all-items line 1 for counties assigned to an OMB Bulletin 23-01 MSA present in MARPP; otherwise SARPP state all-items line 1 labeled state", "utility": "inverse national average-tie ECDF"},
    "safety_hazard": {"formula": "1 - res_hazard_npctl / 100"},
    "water": {
      "active_retail_filter": "from the maximum SUBMISSIONYEARQUARTER only, aggregate SDWA_SERVICE_AREAS to one complete code set per PWSID before a 1:1 join to unique SDWA_PUB_WATER_SYSTEMS; require PWS_TYPE_CODE CWS, PWS_ACTIVITY_CODE A, SUBMISSION_STATUS_CODE Y, positive POPULATION_SERVED_COUNT, and IS_WHOLESALER_IND N or Y. Validate service-area codes against SDWA_REF_CODE_VALUES VALUE_TYPE SERVICE_AREA_TYPE_CODE and require WH to mean Wholesaler of Water. Exclude a Y system as wholesale-only only when its complete current-quarter service-area code set is exactly {WH}; include Y systems with any non-WH service-area code as mixed retail/wholesale. A Y system with no current-quarter service-area row is unscoreable as unknown wholesale-only status. Null/unknown wholesaler flags, conflicting system rows, or unknown service-area codes fail the system classification",
      "allocation": "outside Connecticut, for each usable PWS boundary sum EPA Blocks_V_2_1 Pop20_AW by GEOID20 first five digits, divide by the system total Pop20_AW, and multiply by SDWIS reported population served; Connecticut water is null because 2020 block county digits are legacy counties and no reviewed block-to-planning-region overlay is locked",
      "allocation_coverage": "for each non-Connecticut county, numerator is population allocated from valid, classified active retail system block weights. The denominator also adds the full reported population of each unallocatable-boundary system or unknown-wholesale-only-classification system when SDWIS attributes it to exactly that one current county. Either kind of unscoreable system listing multiple counties makes every listed county null because its denominator cannot be assigned without inventing a split. Unassignable nonpostal or legacy geography is retained as national quality mass but is not assigned to a county",
      "deduplication": "SDWA current-quarter systems must be unique by PWSID; geographic areas by PWSID plus GEO_ID; violations by PWSID plus VIOLATION_ID. Exact duplicate EPA rows collapse. Blocks_V_2_1 may emit the same PWSID/GEOID20 in overlapping singleton and semicolon-delimited PWSID-set strata with different Pop20_AW values; use the maximum Pop20_AW for that PWSID/block as the reviewed conservative union proxy, never sum overlapping strata. Conflicts outside this documented source representation or multiplying joins fail publication. Multiple boundary polygons for one PWSID are dissolved only when all Symbology_Field values agree.",
      "coverage_gate": "allocation_coverage >= 0.90 at county grain; unallocatable-boundary or unknown-classification population attributed to one county is permitted only within the 10% uncovered allowance, either condition with multiple attributed counties makes every listed county null, and Connecticut is explicitly missing_legacy_geography",
      "coverage_floor": 0.9,
      "health_based_violation": "SDWA_VIOLATIONS_ENFORCEMENT IS_HEALTH_BASED_IND Y and NON_COMPL_PER_BEGIN_DATE <= 2025-12-31 and (NON_COMPL_PER_END_DATE is null or >= 2025-01-01), deduplicated to one violating flag per PWSID",
      "overlap_quality": "publish overlap_duplicate_share_proxy = sum by county of (sum Pop20_AW across active retail PWS rows for a GEOID20 - max Pop20_AW for that GEOID20) / sum Pop20_AW across those rows. This treats every smaller same-block intersection as overlapping the largest and therefore can overstate overlap when service areas occupy disjoint portions; label the status max_intersection_proxy and never use it in the score",
      "provenance": "EPA Boundaries.Symbology_Field maps System Sourced to supplied and Modeled to modeled; any other value fails. Publish supplied/modeled/mixed at county grain based on positive allocated system populations.",
      "public_water_coverage": "conservative max-intersection proxy, context only: for each GEOID20 take max Pop20_AW across active retail PWS rows, sum by current county, and divide by Census PEP ESTIMATESBASE2020 county population. This avoids double counting but can understate union coverage when service areas occupy disjoint portions of the same block; label it max_intersection_proxy. Reject negative Pop20_AW and a ratio above 1.005; clamp only a ratio at or below 1.005 to reconcile published block-area population rounding with the county estimates-base denominator. This is never a private-well estimate or score input",
      "reconciliation": "allocated county populations for each usable system must sum to that system's reported population within 1e-9 relative tolerance",
      "score": "water_violation_share = violating allocated system population / all allocated system population; u_water = 1 - water_violation_share",
      "served_county_attribution": "join maximum-quarter SDWA_GEOGRAPHIC_AREAS m:1 to the unique accepted current-quarter SDWA_PUB_WATER_SYSTEMS row by PWSID; submission status and activity are inherited only from that system row because the geographic table has neither field. Keep AREA_TYPE_CODE CN. Require the joined PRIMACY_AGENCY_CODE and the PWSID prefix to agree and be a reviewed two-letter 50-state/DC postal code; STATE_SERVED is blank in the locked artifact and is not used. ANSI_ENTITY_CODE must be exactly three digits; candidate county_fips is the reviewed primacy-state FIPS plus ANSI_ENTITY_CODE. COUNTY_SERVED is descriptive only. Ignore CT, ZC, TR, IR, and other area types. Exact PWSID/candidate-FIPS duplicates collapse; conflicting duplicates, primacy/prefix disagreement, or malformed ANSI fail publication. A non-postal EPA-region/tribal PWS prefix cannot establish state: use its block-derived counties when a valid boundary exists, otherwise record unassignable_served_state and do not invent county denominator mass. If a well-formed candidate FIPS is absent from the locked current universe, including retired 02261, 02270, 32025, and 46113 codes present in the Q2 artifact, use current counties from valid block allocation when available; otherwise record unassignable_legacy_county and do not map or split it. Connecticut legacy county codes remain missing_legacy_geography"
    }
  }
